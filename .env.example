# Copia a .env y completa. NUNCA subas .env al repo.

# Proveedor de LLM: mock (default, sin costo) | openai | anthropic
KORRIENTE_LLM_PROVIDER=mock

# Claves (solo si usas un proveedor real)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Tipo de cambio referencial para mostrar costos en CLP
KORRIENTE_CLP_PER_USD=950

# Límites duros por defecto (true = bloquea al tope; false = solo avisa)
KORRIENTE_HARD_LIMITS=true

# Persistencia: ruta a archivo SQLite. Si se omite, usa memoria (dev/tests).
# Ej: KORRIENTE_DB=./korriente.sqlite3
# KORRIENTE_DB=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
