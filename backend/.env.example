# Variables de entorno de Korriente Agentes
# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitees .env ni compartas los valores.

# ── LLM ──────────────────────────────────────────────────────────────────────
# "mock" para dev/tests (sin gastar dinero), "anthropic" o "openai" en prod.
KORRIENTE_LLM_PROVIDER=mock

# Clave del proveedor LLM (solo en prod). Configura también un tope en el panel del proveedor.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Limites ───────────────────────────────────────────────────────────────────
KORRIENTE_HARD_LIMITS=true
KORRIENTE_NEAR_LIMIT_RATIO=0.8
KORRIENTE_CLP_PER_USD=950

# ── Base de datos ─────────────────────────────────────────────────────────────
# Ruta al SQLite. En Railway: montado en volumen persistente.
KORRIENTE_DB=/data/korriente.db
KORRIENTE_WA_REGISTRY_DB=/data/registry.db
KORRIENTE_DEDUP_DB=/data/dedup.db

# ── WhatsApp / 360dialog (SPEC-005) ───────────────────────────────────────────
# El verify_token lo defines tú; lo configuras también en el panel de 360dialog.
KORRIENTE_WA_VERIFY_TOKEN=
# El app_secret viene del panel de Meta (360dialog > Configuración de webhook).
KORRIENTE_WA_APP_SECRET=
# API key de 360dialog (Configuración > API key).
KORRIENTE_DIALOG360_API_KEY=
# URL base de la API de 360dialog (no cambiar salvo migración).
KORRIENTE_DIALOG360_BASE_URL=https://waba.360dialog.io/v1

# ── Flow.cl (SPEC-006) ────────────────────────────────────────────────────────
# Secret del webhook de Flow (Panel de comercio > Webhooks > Firma).
KORRIENTE_FLOW_WEBHOOK_SECRET=
# API key de Flow (para crear suscripciones programáticamente, si se usa).
KORRIENTE_FLOW_API_KEY=
# Días de gracia antes de suspender un tenant moroso.
KORRIENTE_FLOW_GRACE_DAYS=5
